<VSTemplate Version="3.0.0" Type="Item" xmlns="http://schemas.microsoft.com/developer/vstemplate/2005">
  <TemplateData>
    <Name>State Machine Workflow (CoreWF)</Name>
    <Description>A XAML state-machine workflow for .NET Core and modern .NET. Opens in the patched Workflow Designer. Requires a CoreWF-compatible runtime package in the project.</Description>
    <Icon Package="{FAE04EC1-301F-11d3-BF4B-00C04F79EFBC}" ID="4565" />
    <ProjectType>CSharp</ProjectType>
    <AppliesTo>CSharp + CoreWFModernRuntime</AppliesTo>
    <TemplateID>CoreWF.CSharp.StateMachine</TemplateID>
    <DefaultName>StateMachine.xaml</DefaultName>
    <SortOrder>110</SortOrder>
    <ShowByDefault>false</ShowByDefault>
    <NumberOfParentCategoriesToRollUp>2</NumberOfParentCategoriesToRollUp>
  </TemplateData>
  <TemplateContent>
    <ProjectItem SubType="Designer" ItemType="None" CustomTool="" TargetFileName="$fileinputname$.xaml" ReplaceParameters="true" OpenInEditor="true">Workflow.xaml</ProjectItem>
  </TemplateContent>
</VSTemplate>
